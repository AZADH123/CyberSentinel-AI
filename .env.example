# ---------------------------------------------------------------
# CyberSentinel AI - local development configuration
# Copy to .env. Never commit .env.
# Defaults below keep the app usable offline with no paid keys.
# ---------------------------------------------------------------

APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# PostgreSQL 16 is required. This local URL targets the Compose-published database.
DATABASE_URL=postgresql+asyncpg://cybersentinel:change-me-local@127.0.0.1:55432/cybersentinel
# Inside Docker Compose the API uses: @db:5432/cybersentinel

# External intelligence (empty is valid in mock/off mode)
VIRUSTOTAL_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ENRICHMENT_MODE=mock
ENRICHMENT_TIMEOUT_S=5
ENRICHMENT_DAILY_BUDGET=200
ENRICHMENT_CACHE_TTL_H=24

# LLM is opt-in: provider generation is never required for a valid report.
LLM_ENABLED=false
LLM_TIMEOUT_S=20

CORRELATION_WINDOW_MINUTES=30
CORRELATION_MAX_EVENTS=200
RISK_MODEL_VERSION=risk-v1

MAX_REQUEST_BYTES=262144
RATE_LIMIT_PER_MINUTE=60
MAX_EVENT_AGE_DAYS=90
REVIEWER_NAME=local-reviewer

# Docker Compose database credentials
POSTGRES_DB=cybersentinel
POSTGRES_USER=cybersentinel
POSTGRES_PASSWORD=change-me-local
